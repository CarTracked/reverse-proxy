{
    admin off              # no need for the admin API in Railway's environment
    persist_config off     # storage isn't persistent anyway
    auto_https off         # Railway handles HTTPS for us

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges
    }
}

# Site block, listens on the $PORT env var assigned by Railway
:{$PORT} {

    log {
        format json
    }

    # Redirect legacy login URLs to the new sign-in page.
    @oldLogin path /login /login/*
    redir @oldLogin /v2/sign-in 308

    # Redirect the bare domain and /index to the application's landing page.
    @landing path / /index
    redir @landing /v2/dashboard 302

    # Everything else is proxied to the frontend.
    # With Next.js configured with basePath "/v2", this includes:
    #   /v2
    #   /v2/dashboard
    #   /v2/api/*
    #   /v2/_next/*
    # Clerk authentication routes are handled by Next.js.
    reverse_proxy {$FRONTEND_HOST}
}
