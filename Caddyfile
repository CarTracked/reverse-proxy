caddy
# global options
{
    admin off              # no need for the admin api in
railway's environ
    persist_config off     # storage isn't persistent anyway
    auto_https off         # railway handles https for us
    log {
        format json
    }
    servers {
        trusted_proxies static private_ranges  # trust railway's proxy
    }
}

# site block, listens on the $PORT env var assigned by railway
:{$PORT} {
    log { format json }

    # Bare domain (and anything at the root) -> the app's real landing page.
    # There is no2/dashboarddirectly.
    redir / /v2/dashboard 302

    # Everything
    # basePath "/v2" means pages, /v2/api/*, and /v2/_next/* all
live here,
    # and Clerk auth routing is handled internally by Next.
    reverse_proxy
}
